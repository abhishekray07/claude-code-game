{
  "name": "@claude-code-camp/game",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "claude-code-game": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "frontend/",
    "levels/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build && cd ../frontend && npm install && npm run build && cd ../server && rm -rf frontend && cp -r ../frontend/dist frontend && cp ../README.md README.md",
    "build": "tsc",
    "dev": "tsx watch src/cli.ts --no-open",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "glob": "^13.0.1",
    "node-pty-prebuilt-multiarch": "^0.10.0",
    "open": "^10.1.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
